<% content_for :title, "Admin · Conversations" %>
<% live_refresh %>
<h1>Conversations</h1>
<p class="muted">Every customer who has messaged the number, latest activity first (up to <%= Admin::ConversationsController::LIST_LIMIT %>).</p>

<% if @conversations.empty? %>
  <p class="muted">No conversations yet.</p>
<% else %>
  <table>
    <thead>
      <tr><th>Customer</th><th>Phone</th><th class="num">Messages</th><th>Last activity</th><th>24h window</th><th></th></tr>
    </thead>
    <tbody>
      <% @conversations.each do |conversation| %>
        <tr>
          <td><%= display_name(conversation.customer) %><%= synthetic_badge(conversation.customer) %></td>
          <td><%= display_phone(conversation.customer) %></td>
          <td class="num"><%= @message_counts.fetch(conversation.id, 0) %></td>
          <td class="nowrap"><%= admin_time(conversation.last_message_at) %></td>
          <td><%= window_badge(conversation) %></td>
          <td><%= link_to "View →", admin_conversation_path(conversation) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
