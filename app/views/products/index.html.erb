<% content_for :title, "The Local Table — Menu" %>
<div class="wrap">
  <h1>🍽️ The Local Table</h1>
  <p class="muted">
    This menu mirrors what's synced to the WhatsApp Catalog feed at
    <code><%= catalog_feed_url %></code>. Message our WhatsApp number to
    browse it natively and place an order.
  </p>

  <% @categories.each do |category| %>
    <h2><%= category.name %></h2>
    <div class="card" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;">
      <% category.products.each do |product| %>
        <%= link_to product_path(product), style: "color:inherit;text-decoration:none;" do %>
          <img src="<%= product.image_url %>" alt="<%= product.name %>" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px;">
          <strong style="display:block;margin-top:0.4rem;"><%= product.name %></strong>
          <span class="muted"><%= product.formatted_price %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
