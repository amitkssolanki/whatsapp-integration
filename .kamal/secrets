# Kamal reads this file when deploying. It contains NO secret values: each line only
# references a variable that must already be exported in the shell running `kamal`
# (see docs/deploy/RUNBOOK.md, "Secrets"). Keep the real values outside the repo.

# Registry (GitHub PAT with write:packages for ghcr.io)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails (SECRET_KEY_BASE is used directly; config/master.key is not needed in production)
SECRET_KEY_BASE=$SECRET_KEY_BASE

# PostgreSQL: the app and the accessory must use the same password, so there is one input.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
WHATSAPP_INTEGRATION_DATABASE_PASSWORD=$POSTGRES_PASSWORD

# Meta / WhatsApp (values come from Amit's Meta dashboard)
WHATSAPP_TOKEN=$WHATSAPP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=$WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=$WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_VERIFY_TOKEN=$WHATSAPP_VERIFY_TOKEN
WHATSAPP_APP_SECRET=$WHATSAPP_APP_SECRET
CATALOG_ID=$CATALOG_ID

# Operator UI (HTTP Basic)
ADMIN_USER=$ADMIN_USER
ADMIN_PASSWORD=$ADMIN_PASSWORD
