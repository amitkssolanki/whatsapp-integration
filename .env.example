# Copy to .env and fill in from Meta's App Dashboard / Business Settings.
# See README.md for exactly where each value comes from.

# System User permanent access token with whatsapp_business_messaging
# (+ catalog_management if you want this app to manage the catalog via API later).
WHATSAPP_TOKEN=

# WhatsApp > API Setup > "Phone number ID" for your test/production number.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp > API Setup > "WhatsApp Business Account ID".
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Any string you make up yourself — you'll enter this same value when
# configuring the webhook in the Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=

# App Dashboard > App Settings > Basic > "App secret". Used to verify
# X-Hub-Signature-256 on inbound webhooks. Leave blank to skip verification
# during local testing (not recommended once you're pointed at real Meta traffic).
WHATSAPP_APP_SECRET=

# Commerce Manager > your Catalog > Catalog ID. Not required for the app to
# run — informational / used if you extend this to call the Catalog API.
CATALOG_ID=

# Optional — defaults to v21.0 if unset.
WHATSAPP_API_VERSION=v21.0
