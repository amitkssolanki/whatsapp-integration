# Copy to .env and fill in from Meta's App Dashboard / Business Settings.
# See README.md for exactly where each value comes from.

# System User permanent access token with whatsapp_business_messaging
# (+ catalog_management if you want this app to manage the catalog via API later).
WHATSAPP_TOKEN=

# WhatsApp > API Setup > "Phone number ID" for your test/production number.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp > API Setup > "WhatsApp Business Account ID".
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Any string you make up yourself — you'll enter this same value when
# configuring the webhook in the Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=

# App Dashboard > App Settings > Basic > "App secret". Used to verify
# X-Hub-Signature-256 on inbound webhooks. Webhooks fail closed: with no secret
# every POST is rejected with 401 (see WHATSAPP_ALLOW_UNSIGNED for local curl).
WHATSAPP_APP_SECRET=

# Set to 1 to accept unsigned webhooks while developing locally (e.g. curl).
# Honored ONLY when RAILS_ENV is development or test; production ignores it.
WHATSAPP_ALLOW_UNSIGNED=

# HTTP Basic credentials for the operator UI. Required in production.
ADMIN_USER=
ADMIN_PASSWORD=

# Commerce Manager > your Catalog > Catalog ID. Not required for the app to
# run — informational / used if you extend this to call the Catalog API.
CATALOG_ID=

# Set to "true" to push product changes to the Meta catalog through the Catalog
# API (needs CATALOG_ID and a token with catalog_management). Default off: the
# CSV feed at /catalog/feed.csv stays the source Commerce Manager pulls.
# See docs/v2/CATALOG.md.
CATALOG_SYNC_ENABLED=false

# Optional — defaults to v26.0 if unset (v21.0 expires 2027-01-21).
WHATSAPP_API_VERSION=v26.0
